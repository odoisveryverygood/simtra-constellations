# Copy to `.env` and fill in MODEL_API_KEY. `.env` is git-ignored; never commit the key.
# Azure AI Foundry deployment (grok-4.3, gpt-4o, gpt-5.5 share this base).
GROK_API_URL=https://claude-day-resource.services.ai.azure.com/openai/v1/chat/completions
OPENAI_API_URL=https://claude-day-resource.services.ai.azure.com/openai/v1/responses
MODEL_API_KEY=your-azure-ai-foundry-key-here

# Google Gemini Interactions API (used by model names beginning with `gemini`).
GEMINI_API_KEY=
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/interactions

# InsForge server-side prediction history. Keep the project API key private.
# Local development can omit these when the directory is linked with the InsForge CLI;
# the server will read the ignored `.insforge/project.json` automatically.
INSFORGE_URL=https://your-project.us-west.insforge.app
INSFORGE_API_KEY=your-insforge-project-api-key-here

# Optional RocketRide question router. Leave unset to use the existing local model router.
# Deploy `pipelines/question-router.pipe` and copy the webhook URL/private token from RocketRide.
# The URL may include RocketRide's public auth query parameter when required.
ROCKETRIDE_WEBHOOK_URL=https://your-rocketride-webhook-url
ROCKETRIDE_WEBHOOK_TOKEN=your-rocketride-private-token
# ROCKETRIDE_ENABLED=false

# Optional Neo4j persona memory layer. Leave NEO4J_URI unset to run without memory
# (personas then have no persistent memory of events, tests, or stimuli).
# Paste the variables from an Aura instance's downloaded credentials file verbatim;
# a self-hosted server works with NEO4J_URI=http://localhost:7474.
# Transport is the HTTP Query API (Neo4j 5.x / Aura); set NEO4J_HTTP_API=tx for a 4.x server.
# On Aura free instances NEO4J_DATABASE is the instance id, not `neo4j`.
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-neo4j-password
# NEO4J_DATABASE=xxxxxxxx
# AURA_INSTANCEID=xxxxxxxx
# AURA_INSTANCENAME=Instance01

# TypeSafe Jev: typed A/B comparisons only (no text generation).
TYPESAFE_API_KEY=

# Optional current web context for ordinary predictions (server-side only).
BRAVE_SEARCH_API_KEY=
